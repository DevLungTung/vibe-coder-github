# Server Configuration
PORT=3000

# Database Configuration (optional - uses in-memory by default)
# Uncomment to use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/todos

# Secret used to sign login tokens (required when NODE_ENV=production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me

# Example secret (NEVER commit real values!)
# API_KEY=your-secret-key-here
